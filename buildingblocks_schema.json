{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental-software.com/buildingblocks_0_1_7-SNAPSHOT.json",
  "title": "Building Blocks Specification",
  "description": "Allows to declare visual details for View Elements of IFML specifications. Out of scope are Events and Actions.",
  "type": "object",
  "required": [
    "buildingblocks",
    "info",
    "components"
  ],
  "additionalProperties": true,
  "properties": {
    "buildingblocks": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-SNAPSHOT)?$",
      "description": "Version of the Building Blocks Specification schema."
    },
    "info": {
      "type": "object",
      "description": "Information about this UI specification.",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Title of the UI specification."
        }
      }
    },
    "components": {
      "type": "array",
      "description": "Top-level components of the user interface.",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier of the component."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the component."
        },
        "type": {
          "type": "string",
          "description": "Type of the component, such as Input, Text, or Button."
        },
        "description": {
          "type": "string",
          "description": "Description of the component and its purpose."
        },
        "children": {
          "type": "array",
          "description": "Components contained within this component.",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "properties": {
          "type": "object",
          "description": "Properties specific to the component type."
        },
        "features": {
          "type": "array",
          "description": "Gherkin features describing the behavior of the component.",
          "items": {
            "$ref": "#/$defs/feature"
          }
        }
      },
      "unevaluatedProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Input"
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/inputProperties"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "SplitButton"
              }
            }
          },
          "then": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "$ref": "#/$defs/splitButtonProperties"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "Text",
                  "Input",
                  "Button",
                  "SplitButton"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "children"
              ]
            }
          }
        }
      ]
    },
    "tags": {
      "type": "array",
      "description": "Tags without the leading @, e.g. \"smoke\".",
      "items": {
        "type": "string"
      }
    },
    "feature": {
      "type": "object",
      "description": "Gherkin feature. Structural keywords are derived from the language and not stored.",
      "required": [
        "name",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "description": "Gherkin language code, e.g. \"de\". Defaults to English."
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "description": "Each item contains exactly one of rule, background, scenario.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "rule"
                ]
              },
              {
                "required": [
                  "background"
                ]
              },
              {
                "required": [
                  "scenario"
                ]
              }
            ],
            "properties": {
              "rule": {
                "$ref": "#/$defs/rule"
              },
              "background": {
                "$ref": "#/$defs/background"
              },
              "scenario": {
                "$ref": "#/$defs/scenario"
              }
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "name",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "description": "Each item contains exactly one of background, scenario.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "background"
                ]
              },
              {
                "required": [
                  "scenario"
                ]
              }
            ],
            "properties": {
              "background": {
                "$ref": "#/$defs/background"
              },
              "scenario": {
                "$ref": "#/$defs/scenario"
              }
            }
          }
        }
      }
    },
    "background": {
      "type": "object",
      "required": [
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "description": "A Gherkin scenario. Scenario outlines are expressed by adding the Examples keyword and table as a separate multi-line last step.",
      "required": [
        "name",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "string",
      "minLength": 1,
      "description": "Step text as written, including the leading keyword (Given, When, Then, And, But, *). May be multi-line to include a doc string, or data table. An examples table is a separate last step."
    },
    "splitButtonProperties": {
      "type": "object",
      "required": [
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "persistent": {
          "type": "boolean",
          "description": "Whether the selected option remains preselected."
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "description": "Available options; the first option is the default.",
          "items": {
            "type": "object",
            "required": [
              "textLabel"
            ],
            "additionalProperties": false,
            "properties": {
              "textLabel": {
                "type": "string",
                "description": "Text label of the option."
              },
              "icon": {
                "type": "string",
                "description": "Icon of the option."
              }
            }
          }
        }
      }
    },
    "inputProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Caption for the input field."
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum length of the input value."
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum length of the input value."
        },
        "placeholder": {
          "type": "string",
          "description": "Hint text shown when the input is empty."
        },
        "readonly": {
          "type": "boolean",
          "description": "Flag to disallow editing the input field."
        },
        "required": {
          "type": "boolean",
          "description": "Flag to indicate the parent form is invalid if the input has not been provided."
        },
        "pattern": {
          "type": "string",
          "format": "regex",
          "description": "Regular expression that the input value needs to match."
        },
        "leadingDecorator": {
          "type": "string",
          "description": "Text displayed before the input value."
        },
        "trailingDecorator": {
          "type": "string",
          "description": "Text displayed after the input value."
        },
        "minimumValue": {
          "type": "number",
          "description": "Minimum numeric value accepted by the input."
        },
        "maximumValue": {
          "type": "number",
          "description": "Maximum numeric value accepted by the input."
        },
        "minimumFractionDigits": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of digits displayed after the decimal separator."
        },
        "maximumFractionDigits": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of digits displayed after the decimal separator."
        },
        "locale": {
          "type": "string",
          "description": "Locale used to format the input value."
        }
      }
    }
  }
}
